{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "outDir": "./dist",
    "rootDir": ".",

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true
  },

  "include": ["**/*.ts"],

  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "test-*.ts",
    "**/test-*.ts",
    "tmp-validation-test.py"
  ]
}